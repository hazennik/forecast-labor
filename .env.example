# ===========================
# FORECAST-LABOR ENVIRONMENT
# ===========================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ----------------------------
# ENVIRONMENT
# ----------------------------
ENVIRONMENT=local  # local, development, production

# ----------------------------
# API SERVING (PHASE 6A)
# ----------------------------
# Forecast endpoint in-process rate limit. Keep enabled in Zone 2 unless an
# upstream gateway enforces a stricter limit.
API_SERVICE_NAME=forecast-labor-api
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS_PER_MINUTE=60
ACTIVE_MODEL_BUNDLE=
ZONE2_ARTIFACT_DIR=zone2/runner/artifacts
ZONE2_EXTRACT_DIR=zone2/runner/extracted
ZONE2_API_KEY=

# ----------------------------
# DATA STORAGE
# ----------------------------
# MinIO (local S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=forecast-labor

# PostgreSQL (metadata & MLflow backend)
POSTGRES_USER=forecast_user
POSTGRES_PASSWORD=forecast_pass_change_me
POSTGRES_DB=forecast_labor
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ----------------------------
# MLFLOW TRACKING
# ----------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql://forecast_user:forecast_pass_change_me@postgres:5432/mlflow
MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts

# ----------------------------
# PREFECT (ORCHESTRATION)
# ----------------------------
PREFECT_API_URL=http://prefect:4200/api

# ----------------------------
# PUBLIC DATA SOURCES (APIs)
# ----------------------------
# BLS API (optional - improves rate limits)
BLS_API_KEY=

# NOAA API (optional)
NOAA_API_KEY=

# =============================================================================
# DATA SOURCE FALLBACK BEHAVIOR
# =============================================================================
# Production Safety: Controls whether ETLs can fall back to synthetic data
# when real data sources fail (e.g., API outages, network issues)
#
# PRODUCTION RECOMMENDATION: Set to 'false'
#   - ETLs will fail loudly on data source issues
#   - Alerts operators immediately
#   - Prevents silent data quality degradation
#   - Forces root cause resolution
#
# DEVELOPMENT/TESTING: Set to 'true'
#   - ETLs will use synthetic fallback data
#   - Allows continued development during API outages
#   - Useful for integration tests without external dependencies
#
# DEFAULT (if not set):
#   - Weather ETL: false (safe)
#   - Strikes ETL: false (safe) - changed 2025-11-29
#   - Other ETLs: N/A (no fallback mechanism)
#
# Reference: CODEX_VALIDATION_FIX_REQUIRED.md (2025-11-29)
#
ALLOW_FALLBACK_DATA=false

# ----------------------------
# PRIVATE DATA SOURCES (OPTIONAL)
# ----------------------------
# Homebase
HOMEBASE_API_KEY=
HOMEBASE_API_URL=

# Lightcast / Burning Glass
LIGHTCAST_API_KEY=
LIGHTCAST_CLIENT_ID=

# UKG
UKG_API_KEY=
UKG_API_URL=

# ADP (if using)
ADP_CLIENT_ID=
ADP_CLIENT_SECRET=

# ----------------------------
# BITTENSOR SN41 (PRODUCTION ONLY)
# ----------------------------
# Enable miner service (set to 'true' only on production server)
SN41_MINER_ENABLED=false

# Wallet paths (keep keys in /sn41/keys/, excluded from git)
SN41_HOTKEY_PATH=/sn41/keys/hotkey
SN41_COLDKEY_PATH=/sn41/keys/coldkey

# Subnet configuration
SN41_NETWORK=finney  # finney or test
SN41_NETUID=41

# Submission settings
SN41_SUBMISSION_WINDOW_HOURS=48  # Hours before event to submit

# ----------------------------
# AI AGENTS (OPTIONAL)
# ----------------------------
# OpenAI (for agent operations)
OPENAI_API_KEY=

# Local LLM (if using Ollama)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# Agent autonomy level (0=propose only, 1=auto-merge safe, 2=human review)
AGENT_AUTONOMY_LEVEL=1

# ----------------------------
# LOGGING & MONITORING
# ----------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json  # json or pretty

# Sentry (optional error tracking)
SENTRY_DSN=

# ----------------------------
# CI/CD ACCURACY GATES
# ----------------------------
# Deployment blockers (models must meet these thresholds)
GATE_SMAPE_MAX=0.25
GATE_COVERAGE_MIN=0.78
GATE_COVERAGE_MAX=0.85
GATE_COHERENCE_ERROR_MAX=0.002

# ----------------------------
# TIMEZONE & LOCALE
# ----------------------------
TZ=America/New_York
LANG=en_US.UTF-8
